---
// src/pages/track.astro
import Layout from '../layouts/Layout.astro'; 

// 1. Grab the API key securely from your .env file
const mapKey = import.meta.env.PUBLIC_MAPTILER_KEY;
---

<Layout title="Live Van Tracker | Midah School Bus">
    <main class="max-w-6xl mx-auto p-4 md:p-8">
        <h1 class="text-4xl font-extrabold text-gray-900 mb-2">
            Live <span class="text-yellow-500">Van Tracker</span>
        </h1>
        <p class="text-gray-600 mb-2">
            Watch the school van's location in real-time.
        </p>
        
        <p id="status" class="text-sm font-bold text-red-500 mb-6">
            🔴 Connecting to live server...
        </p>

        <div class="mb-4 max-w-xs">
            <label for="van-select" class="block text-sm font-semibold text-gray-700 mb-2">
                🚚 Filter by Vehicle:
            </label>
            <select id="van-select" class="w-full p-3 bg-white border border-gray-300 rounded-xl shadow-sm font-medium focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 cursor-pointer">
                <option value="all">✨ Show All Vans</option>
            </select>
        </div>

        <div id="map" class="w-full h-[600px] rounded-2xl shadow-xl border border-gray-200 z-10"></div>
    </main>

    <link href="https://unpkg.com/maplibre-gl@3.x/dist/maplibre-gl.css" rel="stylesheet" />
    <script src="https://unpkg.com/maplibre-gl@3.x/dist/maplibre-gl.js" is:inline></script>

    <script is:inline define:vars={{ API_KEY: mapKey }}>
        const styleUrl = `https://api.maptiler.com/maps/streets-v2/style.json?key=${API_KEY}`;
        let defaultPos = [101.73411, 3.10146]; // Default KL
        
        const map = new maplibregl.Map({
            container: 'map', 
            style: styleUrl,
            center: defaultPos,
            zoom: 15,
            maxZoom: 18,
            minZoom: 10,
            touchPitch: false,
            pitchWithRotate: false,
            dragRotate: false
        });

        map.on('error', (e) => {
            console.error('MAP ERROR', e);
        });

        // ==========================================
        // Add the "Locate Me" Blue Dot
        // ==========================================
        const geolocate = new maplibregl.GeolocateControl({
            positionOptions: {
                enableHighAccuracy: true
            },
            trackUserLocation: true,
            showUserHeading: true    
        });
        
        map.addControl(geolocate, 'bottom-right');

        // ==========================================
        // ADVANCED MATH: Calculate Bearing (Rotation)
        // ==========================================
        function getBearing(start, end) {
            const startLat = start[1] * Math.PI / 180;
            const startLng = start[0] * Math.PI / 180;
            const endLat = end[1] * Math.PI / 180;
            const endLng = end[0] * Math.PI / 180;

            const dLng = endLng - startLng;
            const y = Math.sin(dLng) * Math.cos(endLat);
            const x = Math.cos(startLat) * Math.sin(endLat) - Math.sin(startLat) * Math.cos(endLat) * Math.cos(dLng);
            const bearing = Math.atan2(y, x) * 180 / Math.PI;
            return (bearing + 360) % 360;
        }

        // ==========================================
        // Bulletproof Canvas Top-Down Van
        // ==========================================
        function createBusPin() {
            const size = 64;
            const canvas = document.createElement('canvas');
            canvas.width = size; canvas.height = size;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = 'rgba(0,0,0,0.3)';
            ctx.fillRect(14, 10, 36, 48);

            ctx.fillStyle = '#FACC15';
            ctx.fillRect(16, 8, 32, 48);

            ctx.fillStyle = '#1E293B';
            ctx.fillRect(20, 16, 24, 6);
            ctx.fillRect(22, 48, 20, 4);

            ctx.fillStyle = '#FEF08A';
            ctx.fillRect(18, 8, 6, 3);
            ctx.fillRect(40, 8, 6, 3);

            ctx.fillStyle = '#EF4444';
            ctx.fillRect(18, 53, 8, 3);
            ctx.fillRect(38, 53, 8, 3);

            return ctx.getImageData(0, 0, size, size);
        }

        // ==========================================
        // FLEET TRACKING ENGINE (Supports Unlimited Vans)
        // ==========================================
        const fleetTracking = {}; 
        let isFirstPing = true;

        // Dynamically creates data sources and layers per vehicle ID
        function ensureVanLayerExists(vanId, initialPos) {
            const sourceId = `van-source-${vanId}`;
            const layerId = `van-layer-${vanId}`;

            if (map.getSource(sourceId)) return; 

            map.addSource(sourceId, {
                type: 'geojson',
                data: { type: 'Point', coordinates: initialPos }
            });

            map.addLayer({
                id: layerId,
                type: 'symbol',
                source: sourceId,
                layout: {
                    'icon-image': 'bus-icon',
                    'icon-size': 0.8, 
                    'icon-pitch-alignment': 'map',    
                    'icon-rotation-alignment': 'map', 
                    'icon-allow-overlap': true
                }
            });

            // ==========================================
            // NEW: Add this van to the Dropdown Menu
            // ==========================================
            const vanSelect = document.getElementById('van-select');
            if (vanSelect) {
                const option = document.createElement('option');
                option.value = vanId;
                option.textContent = `Van ID: ${vanId}`;
                vanSelect.appendChild(option);
            }

            fleetTracking[vanId] = {
                currentPos: initialPos,
                actualDisplayPos: initialPos,
                animationId: null,
                lastPingTime: performance.now()
            };
        }

        function animateFleetVan(vanId, startPos, endPos, durationMs) {
            const van = fleetTracking[vanId];
            if (!van) return;

            if (van.animationId) cancelAnimationFrame(van.animationId);

            const targetBearing = getBearing(startPos, endPos);
            const layerId = `van-layer-${vanId}`;
            const sourceId = `van-source-${vanId}`;
            
            if (map.getLayer(layerId)) {
                map.setLayoutProperty(layerId, 'icon-rotate', targetBearing);
            }

            let startTimestamp = null;
            
            function step(timestamp) {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / durationMs, 1);
                
                const currentLng = startPos[0] + (endPos[0] - startPos[0]) * progress;
                const currentLat = startPos[1] + (endPos[1] - startPos[1]) * progress;
                
                van.actualDisplayPos = [currentLng, currentLat]; 
                
                if (map.getSource(sourceId)) {
                    map.getSource(sourceId).setData({
                        type: 'Point',
                        coordinates: van.actualDisplayPos
                    });
                }
                
                if (progress < 1) {
                    van.animationId = requestAnimationFrame(step);
                }
            }
            van.animationId = requestAnimationFrame(step);
        }

        async function loadInitialLocation() {
            try {
                const res = await fetch('https://api.midahschoolbus.my/api/vehicles/locations');
                if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
                const fleet = await res.json();
                
                fleet.forEach((vanData, index) => {
                    const vanId = vanData[0];
                    const pos = [vanData[1], vanData[2]];
                    
                    ensureVanLayerExists(vanId, pos);

                    // Frame the map around the first active van discovered
                    if (index === 0 && isFirstPing) {
                        map.jumpTo({ center: pos, zoom: 16 });
                        isFirstPing = false;
                    }
                });
            } catch (err) {
                console.error("Fetch error:", err);
            }
        }
        
        map.on('load', () => {
            map.addImage('bus-icon', createBusPin());
            loadInitialLocation();
        });

        // ==========================================
        // NEW: Dropdown Filter Event Handler
        // ==========================================
        const vanSelect = document.getElementById('van-select');
        
        if (vanSelect) {
            vanSelect.addEventListener('change', (event) => {
                const selectedValue = String(event.target.value);

                // Loop through all tracked vans and toggle visibility
                Object.keys(fleetTracking).forEach(vanId => {
                    const layerId = `van-layer-${vanId}`;
                    
                    if (map.getLayer(layerId)) {
                        if (selectedValue === 'all' || selectedValue === String(vanId)) {
                            map.setLayoutProperty(layerId, 'visibility', 'visible');
                        } else {
                            map.setLayoutProperty(layerId, 'visibility', 'none');
                        }
                    }
                });

                // Smoothly focus camera on the explicitly chosen van
                if (selectedValue !== 'all' && fleetTracking[selectedValue]) {
                    map.flyTo({
                        center: fleetTracking[selectedValue].actualDisplayPos,
                        zoom: 17,
                        essential: true
                    });
                }
            });
        }

        // ==========================================
        // NATIVE SSE LIVE STREAM (Fleet Aware)
        // ==========================================
        const statusText = document.getElementById('status'); 
        const eventSource = new EventSource('https://api.midahschoolbus.my/api/vehicles/stream');

        eventSource.onopen = () => {
            console.log("SSE OPEN");
            if (statusText) {
                statusText.textContent = "🟢 Live Connected";
                statusText.className = "text-sm font-bold text-green-500 mb-6";
            }
        };

        eventSource.onerror = (err) => {
            console.error("SSE ERROR", err);
            if (statusText) {
                statusText.textContent = "🔴 Connection Lost. Reconnecting...";
                statusText.className = "text-sm font-bold text-red-500 mb-6";
            }
        };

        eventSource.onmessage = (event) => {
            const vanData = JSON.parse(event.data);
            console.log("PARSED", vanData);
            const vanId = vanData[0];
            const newPos = [vanData[1], vanData[2]];

            ensureVanLayerExists(vanId, newPos);
            console.log("LAYER OK");

            const van = fleetTracking[vanId];
            const now = performance.now();
            let dynamicDuration = now - van.lastPingTime;
            van.lastPingTime = now;

            dynamicDuration = Math.max(2000, Math.min(dynamicDuration, 4000));

            const startPosToUse = van.actualDisplayPos || van.currentPos;
            console.log("ANIMATING", vanId, newPos);
            animateFleetVan(vanId, startPosToUse, newPos, dynamicDuration);
            van.currentPos = newPos;
        };
    </script>
</Layout>